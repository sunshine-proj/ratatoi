# Copy to .env.local and fill in values. Never commit .env.local.
#
# No environment variables are required for the current build.
#
# Optional hosted sync (Supabase) — planned for Phase 7, not configured yet.
# Only public, browser-safe values may use the NEXT_PUBLIC_ prefix.
# Never put a service-role key in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
